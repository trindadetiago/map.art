GOOGLE_MAPS_API_KEY=
OPENAI_API_KEY=
OXEN_API_KEY=
DATABASE_URL=postgres://jp:jp@localhost:5433/jp

# Storage: "s3" routes blobs through S3/MinIO; "local" keeps them under <repo>/data.
STORAGE_BACKEND=s3
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=mapart
S3_SECRET_ACCESS_KEY=mapartstorage
S3_BUCKET=mapart
S3_FORCE_PATH_STYLE=true

# Render worker: set to "true"/"yes"/"1" to enable GPU acceleration
# Set to "false"/"no"/"0" or leave empty to use SwiftShader CPU software rendering
RENDER_GPU_ENABLED=false

# URL where the render-worker page is served (the Next.js app)
RENDER_WORKER_URL=http://localhost:3210/render-worker

# WebSocket URL for the browser-less renderer (optional)
RENDER_BROWSER_WS=

# Number of times to retry a failed render job
RENDER_RETRY_COUNT=3

# Delay in milliseconds between render retry attempts
RENDER_RETRY_DELAY_MS=5000
