GOOGLE_MAPS_API_KEY=
OPENAI_API_KEY=
OXEN_API_KEY=
DATABASE_URL=postgres://jp:jp@localhost:5433/jp

# Storage: "s3" routes blobs through S3/MinIO; "local" keeps them under <repo>/data.
STORAGE_BACKEND=s3
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=mapart
S3_SECRET_ACCESS_KEY=mapartstorage
S3_BUCKET=mapart

# Render worker: set to "true"/"yes"/"1" to enable GPU acceleration in Chromium
# (Metal on macOS, EGL on Linux). Falsy values use SwiftShader CPU rendering.
RENDER_GPU_ENABLED=false
