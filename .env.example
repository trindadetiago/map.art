GOOGLE_MAPS_API_KEY=
OPENAI_API_KEY=
OXEN_API_KEY=
DATABASE_URL=postgres://jp:jp@localhost:5433/jp

# Storage: blobs are stored in S3/MinIO (preset to the local MinIO from docker-compose).
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=mapart
S3_SECRET_ACCESS_KEY=mapartstorage
S3_BUCKET=mapart

# Bucket holding published pyramids (everything under viz/) — the only objects
# served publicly. Split them out so the credentials that serve the world cannot
# reach the pipeline's renders and stylized output. Leave empty and pyramids stay
# in the main bucket, which is what local dev wants.
VIZ_S3_ENDPOINT=
VIZ_S3_REGION=
VIZ_S3_ACCESS_KEY_ID=
VIZ_S3_SECRET_ACCESS_KEY=
VIZ_S3_BUCKET=

# Origin serving the visualizer's pyramid objects straight from the bucket, with
# a CDN in front (e.g. https://tiles.example.com). Set it and the viewer fetches
# tiles from there instead of through the app; leave empty to keep using the
# app's own /api/viz proxy.
VIZ_PUBLIC_BASE_URL=

# Set to 1 to persist per-tile stylize pipeline artifacts (composite + raw
# model output) to storage for debugging. Doubles upload volume per tile.
STYLIZE_DEBUG_ARTIFACTS=

# Shared password gating the whole apps/web site. When set, visitors must enter
# it at /login before any page loads. Leave empty to disable the gate (local dev).
APP_PASSWORD=

# Injected automatically by Railway in deployed services. Leave empty locally —
# its presence switches worker-stylize from ngrok URLs to presigned S3 URLs.
RAILWAY_ENVIRONMENT_NAME=

# Logging (@mapart/logger). LOG_LEVEL: debug|info|warn|error (default: info on
# Railway, debug locally). LOG_FORMAT: pretty|json (default: json on Railway,
# pretty locally). Leave empty to take the defaults.
LOG_LEVEL=
LOG_FORMAT=

# PostHog project API key (public "Project API Key"). Enables analytics in
# apps/web and apps/visualizer. Leave empty to keep analytics off.
POSTHOG_KEY=

# Share token of a PostHog dashboard with sharing enabled (dashboard -> ... ->
# Share -> Enable sharing; the token is the last path segment of the share URL).
# Embedded by /admin/analytics. Leave empty to show setup instructions instead.
POSTHOG_DASHBOARD_TOKEN=
