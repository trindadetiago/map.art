# project data
!**/debug/**/*.png
!**/docs/**/*.png
.venv/

# Augmented training data — deterministically reproducible from
# python/training/v01/_keep.json + python/augment.py.
python/training/*/_augmented/

# Oxen.ai upload bundle — flat hard-link mirror of _augmented/, generated
# by python/bundle_for_oxen.py just before pushing to hub.oxen.ai.
python/training/*/_oxen_upload/

# Playground inference outputs — cached results from python/playground.py.
python/training/*/_playground/

# Python bytecode caches
__pycache__/
*.pyc

data/

# Local-only scratch dir for CLI render outputs etc. Use freely.
debug/

# Dev runner per-process logs (mprocs + scripts/run.mjs); truncated each run.
.logs/
