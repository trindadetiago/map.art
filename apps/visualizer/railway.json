{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "pnpm --filter @mapart/visualizer build"
  },
  "deploy": {
    "startCommand": "pnpm --filter @mapart/visualizer exec next start --port $PORT --hostname 0.0.0.0",
    "preDeployCommand": "pnpm mapart db migrate",
    "healthcheckPath": "/",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
