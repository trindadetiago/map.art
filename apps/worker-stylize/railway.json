{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "pnpm install --frozen-lockfile --filter @mapart/worker-stylize..."
  },
  "deploy": {
    "startCommand": "pnpm --filter @mapart/worker-stylize exec tsx worker.ts",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
