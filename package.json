{
  "name": "map-art",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "run-setup": "bash scripts/setup.sh",
    "dev": "mprocs",
    "dev:web": "pnpm --filter @mapart/web dev",
    "dev:worker": "pnpm --filter @mapart/worker dev",
    "build": "pnpm -r build",
    "lint": "biome check .",
    "format": "biome format --write .",
    "render": "tsx packages/renderer/bin/cli.ts",
    "generate": "tsx packages/models/bin/cli.ts",
    "storage": "tsx packages/storage/bin/cli.ts",
    "tiles": "tsx packages/tiles/bin/cli.ts",
    "db": "tsx packages/db/bin/cli.ts",
    "db:generate": "pnpm --filter @mapart/db exec drizzle-kit generate",
    "db:migrate": "tsx packages/db/bin/cli.ts migrate",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,jsonc,css}": ["biome check --write --no-errors-on-unmatched"]
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/node": "^22.9.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.5",
    "mprocs": "^0.9.3",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
