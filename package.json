{
  "name": "map-art",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "run-setup": "bash scripts/setup.sh",
    "dev": "node scripts/dev.mjs",
    "dev:web": "pnpm --filter @mapart/web dev",
    "dev:studio": "pnpm --filter @mapart/db drizzle studio",
    "dev:worker-render": "pnpm --filter @mapart/worker-render dev",
    "dev:worker-stylize": "pnpm --filter @mapart/worker-stylize dev",
    "build": "pnpm -r build",
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --workspace-concurrency=1 --if-present test",
    "mapart": "tsx apps/cli/bin/mapart.ts",
    "db:generate": "pnpm --filter @mapart/db exec drizzle-kit generate",
    "db:migrate": "tsx apps/cli/bin/mapart.ts db migrate",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,jsonc,css}": ["biome check --write --no-errors-on-unmatched"],
    "apps/web/**/*.{ts,tsx}": ["bash scripts/check-naming.sh"]
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/node": "^22.9.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.5",
    "mprocs": "^0.9.3",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  },
  "dependencies": {
    "@posthog/react": "^1.10.4",
    "posthog-js": "^1.418.10"
  }
}
